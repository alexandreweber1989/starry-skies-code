VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_NO_AMBIENTE
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_NO_AMBIENTE

# Somente servidor. Não adicionar prefixo VITE_ e não preencher no repositório.
