# ------------------------------------------------------------------------------
# Variáveis de ambiente — Igreja Batista Atos (IB Atos)
# ------------------------------------------------------------------------------
# COPIE este arquivo para `.env` e preencha com os valores reais:
#
#     cp .env.example .env
#
# O `.env` NUNCA é versionado (está no .gitignore). Os valores reais ficam:
#   - localmente, no seu `.env`;
#   - em produção, nas Environment Variables do projeto Vercel `ibaatos-antigo`.
#
# Onde pegar as chaves do Supabase:
#   Painel do Supabase → projeto `dcuncwvmoreagkqivqox`
#   → Settings → API  (URL, anon/publishable key e service_role key).
# ==============================================================================

# --- Supabase: lado do SERVIDOR (SSR / server functions) ----------------------
# URL do projeto. É sempre o projeto de produção da plataforma.
SUPABASE_URL="https://dcuncwvmoreagkqivqox.supabase.co"
# Chave pública (anon / publishable). Pode aparecer no cliente — NÃO é segredo.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# ID do projeto (usado por scripts/migrations).
SUPABASE_PROJECT_ID="dcuncwvmoreagkqivqox"

# --- Supabase: lado do CLIENTE (inlined no build; precisam do prefixo VITE_) ---
# ATENÇÃO: variáveis VITE_* são embutidas no bundle em tempo de build.
# Trocar qualquer uma delas exige um novo deploy para ter efeito.
VITE_SUPABASE_URL="https://dcuncwvmoreagkqivqox.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# Alias aceito pelo cliente caso a publishable não esteja definida.
VITE_SUPABASE_ANON_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="dcuncwvmoreagkqivqox"

# --- Supabase: SEGREDO de administração (service_role) -------------------------
# SOMENTE no servidor. Faz bypass de RLS — jamais exponha no cliente nem comite.
# Necessária para: envio de notificações push, painel de adoção e demais
# server functions que leem dados de todos os usuários.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"
# Alias opcional (algumas partes aceitam SUPABASE_SECRET_KEY como semente).
# SUPABASE_SECRET_KEY="sb_secret_xxx"

# --- Notificações Web Push (VAPID) — OPCIONAIS --------------------------------
# Se vazias, o servidor DERIVA as chaves automaticamente a partir do
# service_role (determinístico e estável entre deploys). Só defina estas se
# quiser gerenciar as chaves manualmente.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:contato@igrejabatistaatos.com.br"
# VAPID_SEED=""

# --- Integrações OPCIONAIS -----------------------------------------------------
# Chave do Google (ex.: APIs de mapa/geocodificação). Deixe vazia se não usar.
# GOOGLE_API_KEY=""
